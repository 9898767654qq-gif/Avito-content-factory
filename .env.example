# Скопируйте в .env и заполните только то, чем реально пользуетесь.
# Без ключей сервис работает: тексты собирает шаблон, Авито — в прогоне.

# База. Относительный путь считается от корня репозитория.
DATABASE_URL=sqlite:///data/factory.db

# Админка
HOST=0.0.0.0
PORT=8741

# Модель. Пустой ключ — детерминированный шаблон, этого достаточно для работы и тестов.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# dry_run — по умолчанию, наружу ничего не уходит.
# live — каркас боевого клиента: публикацию он сознательно не выполняет,
# пока не подтверждены методы API. См. README.
AVITO_CLIENT_MODE=dry_run
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_API_BASE=https://api.avito.ru
# Предположение по открытой схеме OAuth, перед боем сверить:
AVITO_TOKEN_URL=https://api.avito.ru/token

# Фоновая обработка задач доработки внутри фабрики (не путать со службой публикации).
RUN_FACTORY_LOOP=true
FACTORY_POLL_SECONDS=1
WORKER_POLL_SECONDS=1
